{
  "name": "@deepseek-ai/dsh-desktop",
  "description": "Private Windows desktop deployment for the DeepSeek Harness Web application",
  "version": "0.1.3",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "lib/main.js",
  "scripts": {
    "build": "tsc -b && tsdown",
    "build:icon": "node scripts/build-icon.mjs",
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "test": "vitest run --root ../.. apps/desktop/tests"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "electron": "44.0.0",
    "electron-builder": "26.15.3",
    "sharp": "0.35.3"
  }
}
